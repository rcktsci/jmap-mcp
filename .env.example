# Operational settings of jmap-mcp. There is NO secret here: the server has
# no key of its own, the API key of the caller travels with every request.
# Every value below overrides the same key of config.yml.

# Address and port the MCP server listens on.
HOST=127.0.0.1
PORT=8000

# Log level: debug, info, warning, error.
LOG_LEVEL=info

# The upstream mail server (Stalwart).
STALWART_URL=https://mail.example.com
STALWART_SESSION_PATH=/jmap/session

# Timeouts and limits.
REQUEST_TIMEOUT_SEC=30
MAX_ATTACHMENT_MB=25
MAX_PAGE_SIZE=50
MAX_BODY_CHARS=20000

# Where downloaded attachments are written (empty = a temporary directory).
DOWNLOAD_DIR=

# How long a JMAP session document is kept in memory (0 = off).
SESSION_CACHE_TTL_SEC=60

# The JMAP dialect of the upstream: auto, rfc or stalwart.
STALWART_DIALECT=auto
